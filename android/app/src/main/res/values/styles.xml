<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Only used for the window before Compose draws; the UI theme lives in ui/Theme.kt -->
    <style name="RemoteTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
    </style>

    <style name="WidgetButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">4dp</item>
        <item name="android:background">@drawable/widget_button</item>
        <item name="android:scaleType">center</item>
    </style>

    <style name="NotificationButton" parent="WidgetButton">
        <item name="android:background">@drawable/notification_button</item>
        <item name="android:tint">@color/notification_icon</item>
    </style>
</resources>
